<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows-only glue around FocusWindow.Core: driver IOCTLs, display-config queries, DPI read-back,
    the probe window, SendInput, DPAPI pairing storage, and the CLI.
    Build on Windows:  dotnet publish -c Release -r win-x64 (self-contained).
    Compile check on a non-Windows box (cannot run the result): dotnet build, with EnableWindowsTargeting set to true.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>FocusWindow.Agent</AssemblyName>
    <RootNamespace>FocusWindow.Agent</RootNamespace>
    <Version>0.3.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      WFAC010 wants DPI awareness set from a project property instead of the manifest. The manifest is
      deliberate: it takes effect before Main runs, and every density read-back in this agent is
      meaningless in a DPI-virtualised process. Program.RequirePerMonitorV2() verifies it at runtime.
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Publish as a normal self-contained app directory. The former single-file
         bundle required writable %TEMP%\.net extraction just to launch, which
         failed on the test machine. Keep dependencies beside the EXE. -->
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- GPU capture is ONE product dependency, built during the agent build.
         The POC executable is never deployed or launched. -->
    <GpuCmakeGenerator Condition="'$(GpuCmakeGenerator)' == ''">Visual Studio 17 2022</GpuCmakeGenerator>
    <GpuNativeRoot>$(MSBuildProjectDirectory)\..\..\native\FocusWindow.Gpu</GpuNativeRoot>
    <GpuNativeBuildDir>$(GpuNativeRoot)\.build</GpuNativeBuildDir>
    <GpuNativeBinary>$(GpuNativeBuildDir)\bin\$(Configuration)\FocusWindow.Gpu.dll</GpuNativeBinary>
  </PropertyGroup>
  <Target Name="BuildGpuNative" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command='cmake -S &quot;$(GpuNativeRoot)&quot; -B &quot;$(GpuNativeBuildDir)&quot; -G &quot;$(GpuCmakeGenerator)&quot; -A x64' />
    <Exec Command='cmake --build &quot;$(GpuNativeBuildDir)&quot; --config $(Configuration) --target FocusWindow.Gpu' />
    <Copy SourceFiles="$(GpuNativeBinary)" DestinationFiles="$(TargetDir)FocusWindow.Gpu.dll" />
  </Target>
  <Target Name="PackageGpuNative" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT'">
    <Copy SourceFiles="$(GpuNativeBinary)" DestinationFiles="$(PublishDir)FocusWindow.Gpu.dll" />
  </Target>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FocusWindow.Core\FocusWindow.Core.csproj" />
    <ProjectReference Include="..\..\audio\DeskFuse.Audio\DeskFuse.Audio.csproj" />
  </ItemGroup>
</Project>
