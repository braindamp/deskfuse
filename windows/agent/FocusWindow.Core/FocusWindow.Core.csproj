<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Cross-platform core of the host agent: protocol, crypto, framing, encoder, seqlock
    reader, density policy, session logic. Nothing in here touches Win32, so it builds
    and is unit-tested on any OS. The Windows-only glue lives in FocusWindow.Agent.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>0.3.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>FocusWindow.Core</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
